APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=mysql+pymysql://sleepsia:sleepsia@localhost:3306/sleepsia_reporting
SOURCE_WORKBOOK=data/final_sleepsia_report_data.xlsx

# Frontend Environment Variables (Used by Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_DATA=false

# SMTP Configuration for Report Distribution (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Sleepsia Reports

# Report Scheduling
REPORT_SCHEDULE_HOUR=6
REPORT_SCHEDULE_MINUTE=0
REPORT_RECIPIENT_EMAIL=recipient@example.com
REPORT_CC_EMAILS=
REPORT_BCC_EMAILS=
AUTOMATION_TIMEZONE=Asia/Kolkata
SEND_REPORT_EMAIL=false

# Groq API (for AI Business Assistant)
# Get your API key from https://console.groq.com/
GROQ_API_KEY=gsk_your_api_key_here
GROQ_MODEL=mixtral-8x7b-32768

# Hybrid SQL + RAG AI Assistant
# SQL guardrails
SQL_MAX_ROWS=200
SQL_TIMEOUT_MS=5000

# RAG vector store (local ChromaDB, no external service required)
VECTOR_STORE_PATH=backend/data/chroma_store
RAG_COLLECTION_NAME=sleepsia_knowledge
EMBEDDING_MODEL=chromadb-default-onnx-minilm-l6-v2
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.2
RAG_MAX_CONTEXT_TOKENS=1500

# Knowledge base admin endpoints (upload/delete/reindex documents).
# Set this to a long random string; requests must send it as the X-Admin-Key header.
KNOWLEDGE_ADMIN_API_KEY=change-me-to-a-random-secret
KNOWLEDGE_MAX_UPLOAD_MB=10
