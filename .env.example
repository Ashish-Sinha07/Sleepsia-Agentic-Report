APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=mysql+pymysql://sleepsia:sleepsia@localhost:3306/sleepsia_reporting
SOURCE_WORKBOOK=data/final_sleepsia_report_data.xlsx

# Frontend Environment Variables (Used by Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_DATA=false

# SMTP Configuration for Report Distribution (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Sleepsia Reports

# Report Scheduling
REPORT_SCHEDULE_HOUR=6
REPORT_SCHEDULE_MINUTE=0
REPORT_RECIPIENT_EMAIL=ningthoujamrohit91@gmail.com
REPORT_CC_EMAILS=
REPORT_BCC_EMAILS=

# Anthropic API (for AI-based analysis)
ANTHROPIC_API_KEY=your-api-key-here
